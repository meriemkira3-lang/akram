<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Happy birthday, Akram</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Gloock&family=Caveat:wght@500;600&family=Figtree:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --night:#2a0a14; --wine:#5a1424; --red:#d4162f; --sky:#8fb6e6;
  --paper:#fbf6f3; --rule:#e3b9c0; --ink:#3a1220; --blush:#f4d9dc;
  --display:'Gloock',Georgia,'Times New Roman',serif;
  --hand:'Caveat','Bradley Hand','Segoe Script',cursive;
  --body:'Figtree',system-ui,-apple-system,'Segoe UI',sans-serif;
}
*,*::before,*::after{box-sizing:border-box}
html{height:auto;scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--night);color:var(--blush);font-family:var(--body);
  background-image:radial-gradient(120% 60% at 50% 0%,#5a1424 0%,rgba(42,10,20,0) 70%);
  background-repeat:no-repeat;min-height:100vh;-webkit-font-smoothing:antialiased}
main{max-width:520px;margin:0 auto;padding:44px 22px 64px}

/* hero */
.hero{text-align:center}
.date{display:inline-block;font-family:var(--hand);font-size:26px;color:var(--sky);
  transform:rotate(-3deg);margin:0 0 6px}
h1{font-family:var(--display);font-weight:400;margin:0;line-height:.95;
  font-size:clamp(54px,17vw,92px);color:#fff;letter-spacing:-.01em}
h1 span{display:block;color:var(--red);text-shadow:0 2px 0 rgba(0,0,0,.25)}

/* photo */
.photo{position:relative;margin:38px auto 0;width:min(78%,340px);
  background:var(--paper);padding:12px 12px 52px;border-radius:3px;
  transform:rotate(2.5deg);box-shadow:0 24px 50px -12px rgba(0,0,0,.65),0 3px 8px rgba(0,0,0,.35)}
.photo img{display:block;width:100%;aspect-ratio:3/4;object-fit:cover;object-position:50% 30%;border-radius:1px}
.photo figcaption{position:absolute;left:0;right:0;bottom:12px;text-align:center;
  font-family:var(--hand);font-size:23px;line-height:1;color:var(--ink)}
.tape{position:absolute;top:-16px;left:50%;width:96px;height:30px;margin-left:-48px;
  background:rgba(143,182,230,.72);transform:rotate(-4deg);
  box-shadow:0 1px 3px rgba(0,0,0,.25)}

.distance{font-family:var(--display);font-size:clamp(26px,8vw,36px);text-align:center;
  color:#fff;margin:44px 0 0;line-height:1.1}
.distance::after{content:"";display:block;width:64px;height:3px;margin:14px auto 0;
  background:var(--sky);border-radius:2px}

canvas#confetti{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:50}

/* open letter */
.open-wrap{text-align:center;margin:32px 0 0}
.open-btn{font:500 17px/1 var(--body);color:#fff;background:var(--red);border:0;
  border-radius:999px;padding:17px 30px;cursor:pointer;
  box-shadow:0 10px 26px -8px rgba(212,22,47,.8);transition:transform .15s, background .15s}
.open-btn:hover{background:#e8233c}
.open-btn:active{transform:scale(.96)}
.open-btn:focus-visible,.close-btn:focus-visible{outline:3px solid var(--sky);outline-offset:3px}
.open-btn[hidden]{display:none}

.letter-shell{display:grid;grid-template-rows:0fr;transition:grid-template-rows .9s cubic-bezier(.2,.7,.2,1)}
.letter-shell.is-open{grid-template-rows:1fr}
.letter-inner{overflow:hidden;min-height:0}
.letter{margin:36px 0 0;background:var(--paper);color:var(--ink);border-radius:4px;
  padding:34px 26px 30px 44px;position:relative;
  background-image:repeating-linear-gradient(to bottom,transparent 0,transparent 37px,var(--rule) 37px,var(--rule) 38px);
  background-position:0 20px;box-shadow:0 26px 50px -14px rgba(0,0,0,.7);
  transform:translateY(24px);opacity:0;transition:opacity .8s .25s, transform .9s .25s cubic-bezier(.2,.7,.2,1)}
.is-open .letter{opacity:1;transform:none}
.letter::before{content:"";position:absolute;top:0;bottom:0;left:30px;width:2px;background:rgba(212,22,47,.35)}
.letter .to{font-family:var(--display);font-size:30px;line-height:38px;margin:0}
.letter p{font-family:var(--hand);font-weight:500;font-size:25px;line-height:38px;margin:0}
.letter p+p{margin-top:38px}
.letter .sign{font-weight:600;text-align:right;color:var(--wine);font-size:28px}
.heart{display:inline-block;width:.8em;height:.8em;vertical-align:-.05em;fill:var(--red)}

.close-wrap{text-align:center;margin-top:28px}
.close-btn{font:500 15px/1 var(--body);color:var(--blush);background:transparent;
  border:1px solid rgba(244,217,220,.4);border-radius:999px;padding:12px 22px;cursor:pointer}


.start-wrap{text-align:center;margin-top:52px}
.start-btn{font:500 16px/1 var(--body);color:var(--blush);background:transparent;
  border:1px solid rgba(244,217,220,.45);border-radius:999px;padding:15px 26px;cursor:pointer;
  transition:background .15s,transform .15s}
.start-btn:hover{background:rgba(244,217,220,.1)}
.start-btn:active{transform:scale(.96)}
.start-btn:focus-visible{outline:3px solid var(--sky);outline-offset:3px}
[hidden]{display:none!important}

.shot{position:relative;margin:44px auto 0;width:100%;max-width:440px;
  background:var(--paper);padding:12px 12px 52px;border-radius:3px;
  transform:rotate(-2deg);box-shadow:0 24px 50px -12px rgba(0,0,0,.65),0 3px 8px rgba(0,0,0,.35)}
.shot img{display:block;width:100%;height:auto;border-radius:1px}
.shot figcaption{position:absolute;left:0;right:0;bottom:12px;text-align:center;
  font-family:var(--hand);font-size:23px;line-height:1;color:var(--ink)}
.now{font-family:var(--display);font-size:clamp(24px,7vw,32px);text-align:center;color:#fff;
  margin:48px 0 0;line-height:1.15}
.now::after{content:"";display:block;width:64px;height:3px;margin:14px auto 0;background:var(--sky);border-radius:2px}

.hero .in{font-family:var(--hand);font-size:30px;color:var(--sky);margin:10px 0 0}
.pnav{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:52px}
.pnav .open-btn{padding:16px 24px}
.stack{display:flex;flex-direction:column;gap:22px;margin-top:38px}
.zoom{display:block;border:0;cursor:zoom-in;background:var(--paper);padding:7px;border-radius:3px;
  box-shadow:0 18px 36px -12px rgba(0,0,0,.65),0 2px 6px rgba(0,0,0,.35)}
.zoom img{display:block;width:100%;height:auto;border-radius:1px}
.zoom.flat{padding:0;background:none;box-shadow:none}
.zoom:focus-visible{outline:3px solid var(--sky);outline-offset:3px}
.wide{width:100%}
.r1{transform:rotate(-1.6deg)}.r2{transform:rotate(1.4deg)}.r3{transform:rotate(-.8deg)}
.sub{font-family:var(--hand);font-size:30px;color:var(--sky);text-align:center;margin:40px 0 14px}
.calls{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;align-items:start}
.calls .zoom{padding:4px}
.tap{text-align:center;font-size:13px;opacity:.6;margin:20px 0 0}
.doc{position:relative;margin:44px auto 0;width:min(88%,400px);transform:rotate(1.6deg);
  background:var(--paper);padding:10px;border-radius:3px;
  box-shadow:0 24px 50px -12px rgba(0,0,0,.65),0 3px 8px rgba(0,0,0,.35)}
.doc img{display:block;width:100%;height:auto}
.shot.brawl{transform:rotate(1.5deg);padding:10px 10px 52px}
#lb{position:fixed;inset:0;z-index:100;background:rgba(20,4,10,.94);display:flex;
  align-items:center;justify-content:center;padding:16px;cursor:zoom-out}
#lb img{max-width:100%;max-height:100%;object-fit:contain;border-radius:4px}
.song{display:inline-flex;align-items:center;gap:8px;margin-top:22px;padding:11px 18px;
  border-radius:999px;border:1px solid rgba(143,182,230,.55);color:var(--sky);
  font:500 14px/1 var(--body);text-decoration:none;background:rgba(143,182,230,.08)}
.song svg{width:14px;height:14px;fill:currentColor}
.song:focus-visible{outline:3px solid var(--sky);outline-offset:3px}
footer{text-align:center;margin-top:56px;font-family:var(--hand);font-size:24px;color:var(--sky)}

@media (prefers-reduced-motion:reduce){
  .letter-shell,.letter,.open-btn{transition:none}
}
</style>
</head>
<body>
<canvas id="confetti" aria-hidden="true"></canvas>
<main id="page-home" class="page">
  <header class="hero">
    <span class="date">29/09</span>
    <h1>Happy birthday,<span>Akram</span></h1>
    <a class="song" href="https://www.youtube.com/results?search_query=The+Weeknd+Die+For+You" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
      Play our song: Die For You
    </a>
  </header>

  <figure class="photo">
    <i class="tape"></i>
    <img alt="Akram and his girlfriend hugging outside" src="data:image/jpeg;base64,">
    <figcaption>this weird but I love you</figcaption>
  </figure>

  <p class="distance">distance is nothing</p>

  <div class="open-wrap">
    <button class="open-btn" id="openBtn" aria-expanded="false" aria-controls="letter">Open your letter</button>
  </div>

  <div class="letter-shell" id="shell">
    <div class="letter-inner">
      <article class="letter" id="letter" aria-label="Birthday letter">
        <p class="to">Dearest Akram,</p>
        <p>Happy birthday, darling. I love you so much.</p>
        <p>One month ago, saying I love you was a big deal. Right now I feel my love can't be explained. Even saying it 100 times isn't enough, but know this, truly:</p>
        <p>I never expected to fall in love again, but you made me realize that I still have room for love, for the right person (that's you).</p>
        <p class="sign">I love you, Akram
          <svg class="heart" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.4C.9 8.2 2.9 4.5 6.5 4.5c2 0 3.7 1.1 5.5 3 1.8-1.9 3.5-3 5.5-3 3.6 0 5.6 3.7 4.1 7.1C19.5 16.4 12 21 12 21z"/></svg>
        </p>
      </article>
      <div class="close-wrap"><button class="close-btn" id="closeBtn">Close letter</button></div>
    </div>
  </div>

  <div class="start-wrap">
    <button class="start-btn" data-go="start">Where it all started</button>
  </div>

  <footer>29/09, always yours</footer>
</main>

<main id="page-start" class="page" hidden>
  <header class="hero">
    <span class="date">29/04, 11:49 PM</span>
    <h1>It all<span>started here</span></h1>
  </header>

  <figure class="shot">
    <i class="tape"></i>
    <img alt="The first chat: a message saying cc with a sad face, and the reply Coco" src="data:image/jpeg;base64,">
    <figcaption>the message that started everything</figcaption>
  </figure>

  <p class="now">and look where we are now</p>

  <nav class="pnav">
    <button class="start-btn" data-go="home">Back</button>
    <button class="open-btn" data-go="discord">Next: our Discord</button>
  </nav>

  <footer>distance is nothing</footer>
</main>

<main id="page-discord" class="page" hidden>
  <header class="hero">
    <span class="date">the screenshots I kept</span>
    <h1>Our<span>Discord</span></h1>
  </header>

  <div class="stack">
    <button class="zoom wide r1" aria-label="Enlarge screenshot"><img alt="Discord profile with the add friend button" src="data:image/jpeg;base64,"></button>
    <button class="zoom wide r3" aria-label="Enlarge screenshot"><img alt="Discord profile card" src="data:image/jpeg;base64,"></button>
  </div>

  <p class="sub">and the calls</p>
  <div class="calls">
    <button class="zoom r2" aria-label="Enlarge screenshot"><img alt="Discord call screen" src="data:image/jpeg;base64,"></button>
    <button class="zoom r3" aria-label="Enlarge screenshot"><img alt="Discord call screen" src="data:image/jpeg;base64,"></button>
    <button class="zoom r1" aria-label="Enlarge screenshot"><img alt="Discord call screen" src="data:image/jpeg;base64,"></button>
  </div>
  <p class="tap">tap any screenshot to zoom</p>

  <nav class="pnav">
    <button class="start-btn" data-go="start">Back</button>
    <button class="open-btn" data-go="jealous">Next: the official paper</button>
  </nav>
</main>

<main id="page-jealous" class="page" hidden>
  <header class="hero">
    <span class="date">signed by me</span>
    <h1>Officially<span>allowed</span></h1>
  </header>

  <figure class="doc">
    <i class="tape"></i>
    <button class="zoom flat" aria-label="Enlarge document"><img alt="Official consent to be jealous, made out to Akram baby and signed" src="data:image/jpeg;base64,"></button>
  </figure>

  <p class="now">it's in writing, baby</p>

  <nav class="pnav">
    <button class="start-btn" data-go="discord">Back</button>
    <button class="open-btn" data-go="brawl">Next: the rematch</button>
  </nav>
</main>

<main id="page-brawl" class="page" hidden>
  <header class="hero">
    <span class="date">remember when</span>
    <h1>I demolished<span>you</span></h1>
    <p class="in">in your own game</p>
  </header>

  <figure class="shot brawl">
    <i class="tape"></i>
    <button class="zoom flat" aria-label="Enlarge screenshot"><img alt="Brawlhalla results screen: Lizzase wins, Akuma second" src="data:image/jpeg;base64,"></button>
    <figcaption>Lizzase wins!</figcaption>
  </figure>

  <p class="now">1 to 0. rematch whenever you're ready</p>

  <nav class="pnav">
    <button class="start-btn" data-go="jealous">Back</button>
    <button class="open-btn" data-go="home">Back to the start</button>
  </nav>

  <footer>happy birthday, Akram</footer>
</main>

<div id="lb" hidden><img alt=""></div>
<script>
(function(){
  var cv=document.getElementById('confetti'),ctx=cv.getContext('2d'),
      reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      colors=['#d4162f','#ff5a6e','#8fb6e6','#ffffff','#f4d9dc','#e8b34a'],
      bits=[],running=false,W,H,dpr=Math.min(window.devicePixelRatio||1,2);
  function size(){W=innerWidth;H=innerHeight;cv.width=W*dpr;cv.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0)}
  size();addEventListener('resize',size);
  function burst(n,x,y,spread){
    for(var i=0;i<n;i++){
      var a=(-90+(Math.random()-.5)*spread)*Math.PI/180,s=7+Math.random()*9;
      bits.push({x:x,y:y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,w:6+Math.random()*7,h:4+Math.random()*6,
        r:Math.random()*6,vr:(Math.random()-.5)*.35,c:colors[i%colors.length],
        heart:Math.random()<.18,life:0});
    }
    if(!running){running=true;requestAnimationFrame(tick)}
  }
  function tick(){
    ctx.clearRect(0,0,W,H);
    for(var i=bits.length-1;i>=0;i--){
      var b=bits[i];b.life++;
      b.vy+=.28;b.vx*=.985;b.vy*=.985;b.x+=b.vx;b.y+=b.vy;b.r+=b.vr;
      if(b.y>H+30){bits.splice(i,1);continue}
      ctx.save();ctx.translate(b.x,b.y);ctx.rotate(b.r);ctx.fillStyle=b.c;
      if(b.heart){ctx.font=(b.w*2)+'px serif';ctx.fillText('\u2665',-b.w,b.w)}
      else{ctx.scale(1,Math.abs(Math.cos(b.r*1.5))*.9+.1);ctx.fillRect(-b.w/2,-b.h/2,b.w,b.h)}
      ctx.restore();
    }
    if(bits.length){requestAnimationFrame(tick)}else{running=false;ctx.clearRect(0,0,W,H)}
  }
  function party(){
    if(reduce)return;
    burst(70,W*.2,H*.85,70);burst(70,W*.8,H*.85,70);
    setTimeout(function(){burst(60,W*.5,H*.7,90)},300);
  }
  setTimeout(party,500);
  document.querySelector('.photo').addEventListener('click',party);

  var order=['home','start','discord','jealous','brawl'];
  function go(name,fire){
    if(order.indexOf(name)<0)name='home';
    order.forEach(function(n){document.getElementById('page-'+n).hidden=(n!==name)});
    window.scrollTo(0,0);
    try{history.replaceState(null,'',name==='home'?'#':'#'+name)}catch(e){}
    if(fire)party();
  }
  Array.prototype.forEach.call(document.querySelectorAll('[data-go]'),function(b){
    b.addEventListener('click',function(){var n=b.getAttribute('data-go');go(n,n==='brawl'||n==='home')});
  });
  var lb=document.getElementById('lb'),lbImg=lb.querySelector('img');
  Array.prototype.forEach.call(document.querySelectorAll('.zoom'),function(z){
    z.addEventListener('click',function(){lbImg.src=z.querySelector('img').src;lb.hidden=false});
  });
  lb.addEventListener('click',function(){lb.hidden=true});
  addEventListener('keydown',function(ev){if(ev.key==='Escape')lb.hidden=true});
  var h=location.hash.replace('#','');if(h)go(h,false);
  var shell=document.getElementById('shell'),
      openBtn=document.getElementById('openBtn'),
      closeBtn=document.getElementById('closeBtn');
  openBtn.addEventListener('click',function(){
    shell.classList.add('is-open');party();
    openBtn.hidden=true;
    openBtn.setAttribute('aria-expanded','true');
    setTimeout(function(){shell.scrollIntoView({behavior:'smooth',block:'start'})},250);
  });
  closeBtn.addEventListener('click',function(){
    shell.classList.remove('is-open');
    openBtn.hidden=false;
    openBtn.setAttribute('aria-expanded','false');
    openBtn.scrollIntoView({behavior:'smooth',block:'center'});
  });
})();
</script>
</body>
</html>
